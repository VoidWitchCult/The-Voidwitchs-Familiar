	"GutlessGlory.name": "Gutless Glory",
	"GutlessGlory.description": "Delicious, thirst-quenching bowl of flesh-like goodness. Consuming too much may result in-...ah, where's the fun in warning you?",
	"IridiumSnakeMalk.name": "Iridium Snake Malk",
	"IridiumSnakeMalk.description": "I was young once too. Made mistakes, hurt people...now I have grown old and I am still doing the same things. Don't trust me.",
	"KillerChocolateTruffle.name": "Killer Chocolate Truffle",
	"KillerChocolateTruffle.description": "You've been wronged before too, right? Revenge is sweet and a dish best served cold...eat up.",
	"MonsterBlueCupcake.name": "Monster Blue Cupcake",
	"MonsterBlueCupcake.description": "Isn't it adorable how it's looking at you?",
	"PoisonedCandyApple.name": "Poisoned Candy Apple",
	"PoisonedCandyApple.description": "It's fine...all things come to an end. There's always good things coming from ones ruins...",
	"PumpkinCheesecakeTrifle.name": "Pumpkin Cheesecake Trifle",
	"PumpkinCheesecakeTrifle.description": "Delicious fall food best enjoyed cooled. Please take a bite.",
	"PumpkinCremeBrulee.Name": "Pumpkin Creme Brulee",
	"PumpkinCremeBrulee.Description": "Set the world ablaze with this delicious treat! This is fine.",
	"RadioactiveWormSoup.name": "Radioactive Worm Soup",
	"RadioactiveWormSoup.description": "I used to make this when I was a child...what a delight! It glows brightly in the dark...just like you will. If you survive.",
	"SpiderChocolateBrownie.name": "Spider Chocolate Brownie",
	"SpiderChocolateBrownie.description": "Don't worry, no real spiders were harmed making this Brownie.",
	"SunsetSpells.name": "Sunset Spells",
	"SunsetSpells.description": "A fruity refreshing drink with a magical twist!",
	"SuspiciousLiquor.name": "Suspicious Liquor",
	"SuspiciousLiquor.description": "Wait...you weren't supposed to know about this. This is worse than moonshine...",
	"SuspiciousLurkerCookies.name": "Suspicious Lurker Cookies",
	"SuspiciousLurkerCookies.description": "Take a careful look around...there might be something waiting for you...",
	"VampiricRoots.name": "Vampiric Roots",
	"VampiricRoots.description": "Embrace your natural nocturnal urges...quench your thirst.",
	"VoidWitchSignatureSoup.name": "VoidWitch Signature Soup",
	"VoidWitchSignatureSoup.description": "Yum, my favorite!",
	"WineredPepperSoup.name": "Winered Pepper Soup",
	"WineredPepperSoup.description": "Burn bridges and friendships with this devilish hot soup.",
	"WitchyGreenCupcake.name": "Witchy Green Cupcake",
	"WitchyGreenCupcake.description": "A child has offered me one before...very kind. I decided to leave that town peacefully on that day.",
	"FaustsFavorites.name": "Fausts Favorites",
	"FaustsFavorites.description": "If you ever asked what this little fella likes to eat...well, whatever this is.",
	"FriedSkullPotatoes.name": "Fried Skull Potatoes",
	"FriedSkullPotatoes.description": "Potatoes are a great food staple so what's better than a potato? A potato shaped into a skull of course.",
	"PoisonedMash.name": "Poisoned Mash",
