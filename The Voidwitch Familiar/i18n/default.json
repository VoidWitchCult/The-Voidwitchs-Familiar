	"IridiumSnakeMalk.name": "Iridium Snake Malk",
	"IridiumSnakeMalk.description": "I was young once too. Made mistakes, hurt people...now I have grown old and I am still doing the same things. Don't trust me.",
	
	"KillerChocolateTruffle.name": "Killer Chocolate Truffle",
	"KillerChocolateTruffle.description": "You've been wronged before too, right? Revenge is sweet and a dish best served cold...eat up.",
	
	"MonsterBlueCupcake.name": "Monster Blue Cupcake",
	"MonsterBlueCupcake.description": "Isn't it adorable how it's looking at you?",
	
	"PoisonedCandyApple.name": "Poisoned Candy Apple",
	"PoisonedCandyApple.description": "It's fine...all things come to an end. There's always good things coming from ones ruins...",
	
	"PumpkinCheesecakeTrifle.name": "Pumpkin Cheesecake Trifle",
