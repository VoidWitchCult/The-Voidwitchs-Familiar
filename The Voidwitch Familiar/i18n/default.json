	"PumpkinCremeBrulee.Name": "Pumpkin Creme Brulee",
	"PumpkinCremeBrulee.Description": "Set the world ablaze with this delicious treat! This is fine.",
	
	"RadioactiveWormSoup.name": "Radioactive Worm Soup",
	"RadioactiveWormSoup.description": "I used to make this when I was a child...what a delight! It glows brightly in the dark...just like you will. If you survive.",
	
	"SpiderChocolateBrownie.name": "Spider Chocolate Brownie",
